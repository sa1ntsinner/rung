<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: BUSL-1.1 -->
  <!--
    TIA Portal V19 adapter: the V20 sources compiled against the V19 Openness assembly (PublicAPI\V19).
    Not part of Rung.Bridge.sln so machines without V19 keep building.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>rung-bridge-v19</AssemblyName>
    <RootNamespace>Rung.Bridge.V20</RootNamespace>
    <DefineConstants>$(DefineConstants);TIA_V19</DefineConstants>
    <Version>0.1.0</Version>
    <RungOpennessDir Condition="'$(RungOpennessDir)' == ''">C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19</RungOpennessDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Rung.Bridge.V20\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>$(RungOpennessDir)\Siemens.Engineering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Management" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rung.Bridge.Core\Rung.Bridge.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <RungOpennessWhitelistVersion>19.0</RungOpennessWhitelistVersion>
  </PropertyGroup>
  <Import Project="../../../tools/openness/Openness.Whitelist.targets" />
</Project>
