[
  { "label": "rung: agent mode (show)", "command": "rung", "args": ["agent-mode"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: sync", "command": "rung", "args": ["sync"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "no_focus", "save": "all" },
  { "label": "rung: preview sync (what goes where, nothing written)", "command": "rung", "args": ["sync", "--preview"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: turn on writes to TIA Portal", "command": "rung", "args": ["writes", "on"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: turn off writes to TIA Portal", "command": "rung", "args": ["writes", "off"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: watch (keep in sync)", "command": "rung", "args": ["watch"], "cwd": "$ZED_WORKTREE_ROOT", "use_new_terminal": true, "reveal": "no_focus", "save": "all" },
  { "label": "rung: compile this block", "command": "rung", "args": ["compile", "--file", "$ZED_FILE"], "cwd": "$ZED_WORKTREE_ROOT", "tags": ["rung-block"], "save": "all" },
  { "label": "rung: compile PLC", "command": "rung", "args": ["compile"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: compile hardware", "command": "rung", "args": ["compile", "--hw"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: test all", "command": "rung", "args": ["test"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: test this block", "command": "rung", "args": ["test", "--filter", "$ZED_STEM"], "cwd": "$ZED_WORKTREE_ROOT", "tags": ["rung-block"], "save": "all" },
  { "label": "rung: who writes the selected name", "command": "rung", "args": ["who", "$ZED_SELECTED_TEXT", "--file", "$ZED_FILE"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: why is the selected name what it is", "command": "rung", "args": ["why", "$ZED_FILE", "$ZED_SELECTED_TEXT"], "cwd": "$ZED_WORKTREE_ROOT", "save": "all" },
  { "label": "rung: interface impact of this block (before sync)", "command": "rung", "args": ["impact", "$ZED_FILE"], "cwd": "$ZED_WORKTREE_ROOT", "tags": ["rung-block"], "save": "all" },
  { "label": "rung: cross-reference in TIA Portal", "command": "rung", "args": ["xref", "$ZED_FILE"], "cwd": "$ZED_WORKTREE_ROOT", "tags": ["rung-block"], "save": "none" },
  { "label": "rung: go online", "command": "rung", "args": ["online"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: go offline", "command": "rung", "args": ["online", "--off"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: online state", "command": "rung", "args": ["online", "--state"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "no_focus", "save": "none" },
  { "label": "rung: interfaces and reachable devices", "command": "rung", "args": ["interfaces", "--scan"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: compare with PLC", "command": "rung", "args": ["compare"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: download to PLC (asks first)", "command": "rung", "args": ["download"], "cwd": "$ZED_WORKTREE_ROOT", "use_new_terminal": true, "reveal": "always", "allow_concurrent_runs": false, "save": "none" },
  { "label": "rung: open in TIA Portal", "command": "rung", "args": ["open", "$ZED_FILE"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "no_focus", "tags": ["rung-block"], "save": "none" },
  { "label": "rung: status", "command": "rung", "args": ["status"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: pull from TIA Portal", "command": "rung", "args": ["pull"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: views (hardware, HMI, technology objects, library)", "command": "rung", "args": ["views"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" },
  { "label": "rung: resolve conflict, keep my file", "command": "rung", "args": ["resolve", "$ZED_FILE", "--ours"], "cwd": "$ZED_WORKTREE_ROOT", "save": "current" },
  { "label": "rung: resolve conflict, take TIA's version", "command": "rung", "args": ["resolve", "$ZED_FILE", "--theirs"], "cwd": "$ZED_WORKTREE_ROOT", "save": "none" }
]
