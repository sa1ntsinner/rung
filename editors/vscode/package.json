{
  "name": "rung-scl",
  "displayName": "rung: SCL and TIA Portal sync",
  "description": "Siemens SCL language support and two-way TIA Portal sync, compile, online and download through the rung CLI.",
  "version": "0.2.0",
  "publisher": "sa1ntsinner",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sa1ntsinner/rung"
  },
  "bugs": {
    "url": "https://github.com/sa1ntsinner/rung/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "scl",
    "siemens",
    "tia portal",
    "plc",
    "structured text",
    "iec 61131-3",
    "twincat",
    "s7"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:rung.environment",
    "workspaceContains:rung.toml",
    "workspaceContains:**/*.TcPOU",
    "workspaceContains:**/*.st",
    "onLanguage:scl",
    "onLanguage:s7dcl",
    "onWebviewPanel:rung.declarations",
    "onCustomEditor:rung.udtTable",
    "onCustomEditor:rung.testTable"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In restricted mode rung.command from workspace settings is ignored.",
      "restrictedConfigurations": [
        "rung.command"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "scl",
        "aliases": [
          "SCL",
          "Siemens SCL",
          "IEC Structured Text"
        ],
        "extensions": [
          ".scl",
          ".db",
          ".udt",
          ".awl",
          ".st"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "s7dcl",
        "aliases": [
          "LAD (SIMATIC SD)",
          "s7dcl"
        ],
        "extensions": [
          ".s7dcl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scl",
        "scopeName": "source.scl",
        "path": "./syntaxes/scl.tmLanguage.json"
      },
      {
        "language": "s7dcl",
        "scopeName": "source.s7dcl",
        "path": "./syntaxes/s7dcl.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rung",
          "title": "rung",
          "icon": "media/rung.svg"
        }
      ]
    },
    "views": {
      "rung": [
        {
          "id": "rung.project",
          "name": "Project",
          "icon": "media/rung.svg",
          "contextualTitle": "rung"
        },
        {
          "id": "rung.plc",
          "name": "PLC",
          "icon": "media/rung.svg",
          "contextualTitle": "rung"
        },
        {
          "id": "rung.environment",
          "name": "Environment",
          "icon": "media/rung.svg",
          "contextualTitle": "rung",
          "visibility": "collapsed"
        },
        {
          "id": "rung.usages",
          "name": "Usages",
          "icon": "media/rung.svg",
          "contextualTitle": "rung"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rung.project",
        "contents": "Open the folder that holds (or should hold) the rung workspace.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "rung.project",
        "contents": "This folder has no rung.toml. rung mirrors a TIA Portal project into text files here and keeps both in sync.\n[Initialize from a TIA Portal project](command:rung.init)\n[Read the docs](command:rung.openDocs)",
        "when": "workbenchState != empty && !rung.workspace"
      },
      {
        "view": "rung.project",
        "contents": "Nothing is mirrored yet.\n[Pull from TIA Portal](command:rung.pull)\n[Start watch](command:rung.watch.start)",
        "when": "rung.workspace && !rung.hasObjects"
      },
      {
        "view": "rung.plc",
        "contents": "PLC actions (online, compile, download) show up here once the folder has a rung.toml.",
        "when": "!rung.workspace"
      },
      {
        "view": "rung.usages",
        "contents": "Put the cursor on a name in an SCL file and run Who Writes This? (Alt+Q U).\n[Who Writes This?](command:rung.whoWrites)"
      }
    ],
    "commands": [
      {
        "command": "rung.assignments",
        "title": "Assignment List (Used I/O and Memory)",
        "category": "rung",
        "icon": "$(list-tree)"
      },
      {
        "command": "rung.monitor.toggle",
        "title": "Monitor Values (Live)",
        "category": "rung",
        "icon": "$(eye)"
      },
      {
        "command": "rung.monitor.stop",
        "title": "Stop Monitoring",
        "category": "rung",
        "icon": "$(eye-closed)"
      },
      {
        "command": "rung.env.refresh",
        "title": "Check This PC Again",
        "category": "rung",
        "icon": "$(refresh)"
      },
      {
        "command": "rung.installCommand",
        "title": "Put rung on PATH (for Terminals and Agents)",
        "category": "rung",
        "icon": "$(terminal)"
      },
      {
        "command": "rung.env.fix",
        "title": "Fix",
        "category": "rung"
      },
      {
        "command": "rung.setup",
        "title": "Set Up Editors and Agents…",
        "category": "rung",
        "icon": "$(tools)"
      },
      {
        "command": "rung.pull",
        "title": "Pull from TIA Portal",
        "category": "rung",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rung.sync",
        "title": "Sync Now",
        "category": "rung",
        "icon": "$(sync)"
      },
      {
        "command": "rung.watch.start",
        "title": "Start Watch",
        "category": "rung",
        "icon": "$(eye)"
      },
      {
        "command": "rung.watch.stop",
        "title": "Stop Watch",
        "category": "rung",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rung.watch.toggle",
        "title": "Toggle Watch",
        "category": "rung",
        "icon": "$(eye)"
      },
      {
        "command": "rung.watch.show",
        "title": "Show Watch Terminal",
        "category": "rung"
      },
      {
        "command": "rung.status",
        "title": "Show Status",
        "category": "rung",
        "icon": "$(info)"
      },
      {
        "command": "rung.preview",
        "title": "Preview Sync",
        "category": "rung",
        "icon": "$(eye)"
      },
      {
        "command": "rung.whoWrites",
        "title": "Who Writes This?",
        "category": "rung",
        "icon": "$(references)"
      },
      {
        "command": "rung.writes.on",
        "title": "Turn On Writes to TIA Portal",
        "category": "rung",
        "icon": "$(unlock)"
      },
      {
        "command": "rung.writes.off",
        "title": "Turn Off Writes to TIA Portal",
        "category": "rung",
        "icon": "$(lock)"
      },
      {
        "command": "rung.quickPick",
        "title": "Actions…",
        "category": "rung",
        "icon": "$(list-flat)"
      },
      {
        "command": "rung.views",
        "title": "Write Read-Only Views (Hardware, HMI, Tags)",
        "category": "rung"
      },
      {
        "command": "rung.compileFile",
        "title": "Compile This File",
        "category": "rung",
        "icon": "$(tools)"
      },
      {
        "command": "rung.compilePlc",
        "title": "Compile PLC",
        "category": "rung",
        "icon": "$(tools)"
      },
      {
        "command": "rung.compileHardware",
        "title": "Compile Hardware",
        "category": "rung",
        "icon": "$(circuit-board)"
      },
      {
        "command": "rung.testAll",
        "title": "Test All",
        "category": "rung",
        "icon": "$(beaker)"
      },
      {
        "command": "rung.testBlock",
        "title": "Test This Block",
        "category": "rung",
        "icon": "$(beaker)"
      },
      {
        "command": "rung.goOnline",
        "title": "Go Online",
        "category": "rung",
        "icon": "$(plug)"
      },
      {
        "command": "rung.goOffline",
        "title": "Go Offline",
        "category": "rung",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "rung.onlineState",
        "title": "Online State",
        "category": "rung",
        "icon": "$(pulse)"
      },
      {
        "command": "rung.refreshPlc",
        "title": "Refresh Online State",
        "category": "rung",
        "icon": "$(refresh)"
      },
      {
        "command": "rung.connect",
        "title": "Connect… (Find the PLC, Choose the Connection)",
        "category": "rung",
        "icon": "$(link)"
      },
      {
        "command": "rung.interfaces",
        "title": "Interfaces and Reachable Devices…",
        "category": "rung",
        "icon": "$(radio-tower)"
      },
      {
        "command": "rung.download",
        "title": "Download to PLC…",
        "category": "rung",
        "icon": "$(desktop-download)",
        "enablement": "!rung.downloading"
      },
      {
        "command": "rung.compare",
        "title": "Compare with PLC",
        "category": "rung",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "rung.rename",
        "title": "Rename in TIA Portal…",
        "category": "rung",
        "icon": "$(edit)"
      },
      {
        "command": "rung.openInTia",
        "title": "Open in TIA Portal",
        "category": "rung",
        "icon": "$(link-external)"
      },
      {
        "command": "rung.resolveOurs",
        "title": "Resolve Conflict: Keep My File",
        "category": "rung",
        "icon": "$(file)"
      },
      {
        "command": "rung.resolveTheirs",
        "title": "Resolve Conflict: Take TIA Version",
        "category": "rung",
        "icon": "$(cloud)"
      },
      {
        "command": "rung.openConfig",
        "title": "Open rung.toml",
        "category": "rung",
        "icon": "$(settings-gear)"
      },
      {
        "command": "rung.showOutput",
        "title": "Show Output",
        "category": "rung",
        "icon": "$(output)"
      },
      {
        "command": "rung.refresh",
        "title": "Refresh",
        "category": "rung",
        "icon": "$(refresh)"
      },
      {
        "command": "rung.projectView.groupByKind",
        "title": "Group by Block Type",
        "category": "rung",
        "icon": "$(symbol-class)"
      },
      {
        "command": "rung.projectView.groupByFolder",
        "title": "Group by Folder",
        "category": "rung",
        "icon": "$(list-tree)"
      },
      {
        "command": "rung.init",
        "title": "Initialize from a TIA Portal Project…",
        "category": "rung",
        "icon": "$(add)"
      },
      {
        "command": "rung.openDocs",
        "title": "Open Documentation",
        "category": "rung"
      },
      {
        "command": "rung.restartServer",
        "title": "Restart Language Server",
        "category": "rung"
      },
      {
        "command": "rung.declarations.open",
        "title": "Show Declarations",
        "category": "rung",
        "icon": "$(table)"
      },
      {
        "command": "rung.newObject",
        "title": "New Object…",
        "category": "rung",
        "icon": "$(add)"
      },
      {
        "command": "rung.test.create",
        "title": "Create Test",
        "category": "rung",
        "icon": "$(beaker)"
      },
      {
        "command": "rung.test.openTable",
        "title": "Open Test as Table",
        "category": "rung",
        "icon": "$(table)"
      },
      {
        "command": "rung.udt.openTable",
        "title": "Open as Table",
        "category": "rung",
        "icon": "$(table)"
      },
      {
        "command": "rung.usages.show",
        "title": "Show Usages",
        "category": "rung"
      },
      {
        "command": "rung.usages.refresh",
        "title": "Refresh Usages",
        "category": "rung",
        "icon": "$(refresh)"
      },
      {
        "command": "rung.usages.history",
        "title": "Earlier Usages",
        "category": "rung",
        "icon": "$(history)"
      },
      {
        "command": "rung.usages.pick",
        "title": "Who Writes This? (Quick Pick)",
        "category": "rung"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rung.newObject",
          "when": "rung.workspace"
        },
        {
          "command": "rung.test.create",
          "when": "rung.workspace && editorLangId == scl"
        },
        {
          "command": "rung.env.fix",
          "when": "false"
        },
        {
          "command": "rung.compare",
          "when": "rung.workspace"
        },
        {
          "command": "rung.rename",
          "when": "rung.workspace && resourceExtname =~ /^\\.(scl|db|udt|s7dcl|xml)$/"
        },
        {
          "command": "rung.pull",
          "when": "rung.workspace"
        },
        {
          "command": "rung.sync",
          "when": "rung.workspace"
        },
        {
          "command": "rung.watch.start",
          "when": "rung.workspace && !rung.watching"
        },
        {
          "command": "rung.watch.stop",
          "when": "rung.workspace && rung.watching"
        },
        {
          "command": "rung.watch.toggle",
          "when": "rung.workspace"
        },
        {
          "command": "rung.watch.show",
          "when": "false"
        },
        {
          "command": "rung.status",
          "when": "rung.workspace"
        },
        {
          "command": "rung.preview",
          "when": "rung.workspace"
        },
        {
          "command": "rung.writes.on",
          "when": "rung.workspace"
        },
        {
          "command": "rung.writes.off",
          "when": "rung.workspace"
        },
        {
          "command": "rung.views",
          "when": "rung.workspace"
        },
        {
          "command": "rung.compileFile",
          "when": "rung.workspace && editorLangId == scl"
        },
        {
          "command": "rung.compilePlc",
          "when": "rung.workspace"
        },
        {
          "command": "rung.compileHardware",
          "when": "rung.workspace"
        },
        {
          "command": "rung.testBlock",
          "when": "editorLangId == scl"
        },
        {
          "command": "rung.goOnline",
          "when": "rung.workspace"
        },
        {
          "command": "rung.goOffline",
          "when": "rung.workspace"
        },
        {
          "command": "rung.onlineState",
          "when": "rung.workspace"
        },
        {
          "command": "rung.refreshPlc",
          "when": "false"
        },
        {
          "command": "rung.connect",
          "when": "rung.workspace"
        },
        {
          "command": "rung.interfaces",
          "when": "rung.workspace"
        },
        {
          "command": "rung.download",
          "when": "rung.workspace"
        },
        {
          "command": "rung.openInTia",
          "when": "rung.workspace && editorLangId == scl"
        },
        {
          "command": "rung.resolveOurs",
          "when": "rung.workspace && rung.hasConflicts"
        },
        {
          "command": "rung.resolveTheirs",
          "when": "rung.workspace && rung.hasConflicts"
        },
        {
          "command": "rung.openConfig",
          "when": "rung.workspace"
        },
        {
          "command": "rung.refresh",
          "when": "false"
        },
        {
          "command": "rung.projectView.groupByKind",
          "when": "false"
        },
        {
          "command": "rung.projectView.groupByFolder",
          "when": "false"
        },
        {
          "command": "rung.init",
          "when": "!rung.workspace"
        },
        {
          "command": "rung.usages.show",
          "when": "false"
        },
        {
          "command": "rung.usages.refresh",
          "when": "rung.hasUsages"
        },
        {
          "command": "rung.usages.history",
          "when": "rung.hasUsages"
        }
      ],
      "view/title": [
        {
          "command": "rung.env.refresh",
          "when": "view == rung.environment",
          "group": "navigation@1"
        },
        {
          "command": "rung.setup",
          "when": "view == rung.environment",
          "group": "navigation@2"
        },
        {
          "command": "rung.newObject",
          "when": "view == rung.project",
          "group": "navigation@0"
        },
        {
          "command": "rung.sync",
          "when": "view == rung.project",
          "group": "navigation@1"
        },
        {
          "command": "rung.projectView.groupByKind",
          "when": "view == rung.project && config.rung.projectView.grouping != kind",
          "group": "navigation@2"
        },
        {
          "command": "rung.projectView.groupByFolder",
          "when": "view == rung.project && config.rung.projectView.grouping == kind",
          "group": "navigation@2"
        },
        {
          "command": "rung.refresh",
          "when": "view == rung.project",
          "group": "navigation@3"
        },
        {
          "command": "rung.pull",
          "when": "view == rung.project",
          "group": "1_sync@1"
        },
        {
          "command": "rung.status",
          "when": "view == rung.project",
          "group": "1_sync@2"
        },
        {
          "command": "rung.views",
          "when": "view == rung.project",
          "group": "1_sync@3"
        },
        {
          "command": "rung.assignments",
          "when": "view == rung.project",
          "group": "1_sync@4"
        },
        {
          "command": "rung.openConfig",
          "when": "view == rung.project",
          "group": "2_workspace@1"
        },
        {
          "command": "rung.showOutput",
          "when": "view == rung.project",
          "group": "2_workspace@2"
        },
        {
          "command": "rung.refreshPlc",
          "when": "view == rung.plc && rung.workspace",
          "group": "navigation@1"
        },
        {
          "command": "rung.connect",
          "when": "view == rung.plc && rung.workspace",
          "group": "1_plc@0"
        },
        {
          "command": "rung.interfaces",
          "when": "view == rung.plc && rung.workspace",
          "group": "1_plc@1"
        },
        {
          "command": "rung.openConfig",
          "when": "view == rung.plc && rung.workspace",
          "group": "2_workspace@1"
        },
        {
          "command": "rung.showOutput",
          "when": "view == rung.plc",
          "group": "2_workspace@2"
        },
        {
          "command": "rung.usages.history",
          "when": "view == rung.usages && rung.hasUsages",
          "group": "navigation@1"
        },
        {
          "command": "rung.usages.refresh",
          "when": "view == rung.usages && rung.hasUsages",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "rung.compileFile",
          "when": "view == rung.project && viewItem =~ /\\bcompilable\\b/",
          "group": "inline@1"
        },
        {
          "command": "rung.openInTia",
          "when": "view == rung.project && viewItem =~ /\\bopenable\\b/",
          "group": "inline@2"
        },
        {
          "command": "rung.compileFile",
          "when": "view == rung.project && viewItem =~ /\\bcompilable\\b/",
          "group": "1_build@1"
        },
        {
          "command": "rung.testBlock",
          "when": "view == rung.project && viewItem =~ /\\btestable\\b/",
          "group": "1_build@2"
        },
        {
          "command": "rung.openInTia",
          "when": "view == rung.project && viewItem =~ /\\bopenable\\b/",
          "group": "1_build@3"
        },
        {
          "command": "rung.resolveOurs",
          "when": "view == rung.project && viewItem =~ /\\bconflicted\\b/",
          "group": "0_conflict@1"
        },
        {
          "command": "rung.resolveTheirs",
          "when": "view == rung.project && viewItem =~ /\\bconflicted\\b/",
          "group": "0_conflict@2"
        },
        {
          "command": "rung.compilePlc",
          "when": "view == rung.project && viewItem == rung.device",
          "group": "1_build@1"
        },
        {
          "command": "rung.watch.start",
          "when": "view == rung.plc && viewItem == rung.watch.stopped",
          "group": "inline"
        },
        {
          "command": "rung.watch.stop",
          "when": "view == rung.plc && viewItem == rung.watch.running",
          "group": "inline"
        },
        {
          "command": "rung.goOnline",
          "when": "view == rung.plc && viewItem == rung.plc",
          "group": "inline@1"
        },
        {
          "command": "rung.goOffline",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc online$/",
          "group": "inline@1"
        },
        {
          "command": "rung.onlineState",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "inline@2"
        },
        {
          "command": "rung.goOnline",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "1_online@1"
        },
        {
          "command": "rung.goOffline",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "1_online@2"
        },
        {
          "command": "rung.onlineState",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "1_online@3"
        },
        {
          "command": "rung.compilePlc",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "2_build@1"
        },
        {
          "command": "rung.compileHardware",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "2_build@2"
        },
        {
          "command": "rung.connect",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "3_plc@0"
        },
        {
          "command": "rung.interfaces",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "3_plc@1"
        },
        {
          "command": "rung.openConfig",
          "when": "view == rung.plc && viewItem == rung.connection",
          "group": "inline"
        },
        {
          "command": "rung.download",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "3_plc@2"
        },
        {
          "command": "rung.compare",
          "when": "view == rung.plc && viewItem =~ /^rung\\.plc\\b/",
          "group": "1_online@4"
        }
      ],
      "editor/title": [
        {
          "command": "rung.declarations.open",
          "when": "resourceLangId == scl && resourceExtname != .udt",
          "group": "navigation@0"
        },
        {
          "command": "rung.udt.openTable",
          "when": "resourceExtname == .udt && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation@0"
        },
        {
          "command": "rung.test.openTable",
          "when": "resourceFilename =~ /\\.test\\.ya?ml$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation@0"
        },
        {
          "command": "rung.compileFile",
          "when": "rung.workspace && resourceLangId == scl",
          "group": "navigation@1"
        },
        {
          "command": "rung.testBlock",
          "when": "rung.workspace && resourceLangId == scl",
          "group": "navigation@2"
        },
        {
          "command": "rung.openInTia",
          "when": "rung.workspace && resourceLangId == scl",
          "group": "navigation@3"
        },
        {
          "command": "rung.monitor.toggle",
          "when": "rung.workspace && resourceLangId == scl && !rung.monitoring",
          "group": "navigation@4"
        },
        {
          "command": "rung.monitor.stop",
          "when": "rung.workspace && rung.monitoring",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "rung.resolveOurs",
          "when": "rung.workspace && resourceExtname =~ /^\\.(conflict|tia)$/",
          "group": "rung@1"
        },
        {
          "command": "rung.resolveTheirs",
          "when": "rung.workspace && resourceExtname =~ /^\\.(conflict|tia)$/",
          "group": "rung@2"
        },
        {
          "command": "rung.rename",
          "when": "rung.workspace && resourceExtname =~ /^\\.(scl|db|udt|s7dcl)$/",
          "group": "rung@3"
        },
        {
          "command": "rung.whoWrites",
          "when": "editorLangId == scl || editorLangId == s7dcl",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "rung.rename",
          "when": "rung.workspace && resourceExtname =~ /^\\.(scl|db|udt|s7dcl|xml)$/",
          "group": "rung@5"
        },
        {
          "command": "rung.compileFile",
          "when": "rung.workspace && resourceLangId == scl",
          "group": "rung@1"
        },
        {
          "command": "rung.openInTia",
          "when": "rung.workspace && resourceLangId == scl",
          "group": "rung@2"
        },
        {
          "command": "rung.resolveOurs",
          "when": "rung.workspace && resourceExtname =~ /^\\.(conflict|tia)$/",
          "group": "rung@3"
        },
        {
          "command": "rung.resolveTheirs",
          "when": "rung.workspace && resourceExtname =~ /^\\.(conflict|tia)$/",
          "group": "rung@4"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "rung.testTable",
        "displayName": "Test Table",
        "selector": [
          {
            "filenamePattern": "*.test.yaml"
          },
          {
            "filenamePattern": "*.test.yml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "rung.udtTable",
        "displayName": "UDT Table",
        "selector": [
          {
            "filenamePattern": "*.udt"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "key": "alt+q s",
        "command": "rung.sync",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q shift+s",
        "command": "rung.preview",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q u",
        "command": "rung.whoWrites",
        "when": "editorLangId == scl || editorLangId == s7dcl"
      },
      {
        "key": "alt+q v",
        "command": "rung.monitor.toggle",
        "when": "rung.workspace && editorLangId == scl"
      },
      {
        "key": "alt+q w",
        "command": "rung.watch.toggle",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q b",
        "command": "rung.compileFile",
        "when": "rung.workspace && editorLangId == scl"
      },
      {
        "key": "alt+q shift+b",
        "command": "rung.compilePlc",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q h",
        "command": "rung.compileHardware",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q t",
        "command": "rung.testBlock",
        "when": "rung.workspace && editorLangId == scl"
      },
      {
        "key": "alt+q shift+t",
        "command": "rung.testAll",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q o",
        "command": "rung.goOnline",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q f",
        "command": "rung.goOffline",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q c",
        "command": "rung.connect",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q i",
        "command": "rung.interfaces",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q d",
        "command": "rung.download",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q m",
        "command": "rung.compare",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q r",
        "command": "rung.rename",
        "when": "rung.workspace && editorLangId =~ /^(scl|s7dcl)$/"
      },
      {
        "key": "alt+q e",
        "command": "rung.openInTia",
        "when": "rung.workspace && editorLangId == scl"
      },
      {
        "key": "alt+q p",
