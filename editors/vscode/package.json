        "when": "rung.workspace"
      },
      {
        "key": "alt+q q",
        "command": "rung.quickPick",
        "when": "rung.workspace"
      },
      {
        "key": "alt+q a",
        "command": "rung.declarations.open",
        "when": "editorLangId == scl"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "order": 1,
        "properties": {
          "rung.command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "rung"
            ],
            "scope": "machine-overridable",
            "markdownDescription": "How to start the rung CLI: the program and any leading arguments. `[\"rung\"]` uses `rung` from PATH. For a source checkout: `[\"node\", \"C:/path/to/rung/packages/cli/dist/index.js\"]`. The language server, the views and all commands use it."
          },
          "rung.watch.autoStart": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Start `rung watch` in a terminal when a folder with `rung.toml` opens. Watch keeps files and TIA Portal in sync and runs the other commands through its TIA Portal session."
          },
          "rung.terminal.reuse": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Run commands such as sync, compile and test one after another in a single **rung** terminal. Off: every command gets a new terminal. Downloads and `rung watch` always get their own."
          },
          "rung.output.verbosity": {
            "type": "string",
            "enum": [
              "quiet",
              "normal",
              "verbose"
            ],
            "enumDescriptions": [
              "Only failures.",
              "Command lines and the output of background commands.",
              "Also background refreshes, how rung is started and workspace reloads."
            ],
            "default": "normal",
            "description": "How much the extension writes to the rung output channel."
          },
          "rung.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Log the messages between VS Code and the rung language server."
          }
        }
      },
      {
        "title": "Editor",
        "order": 2,
        "properties": {
          "rung.codeLens.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show **Compile · Test · Open in TIA Portal** above each block header (`FUNCTION_BLOCK`, `FUNCTION`, `ORGANIZATION_BLOCK`, `DATA_BLOCK`, `TYPE`)."
          },
          "rung.compileOnSave": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Run `rung compile --file` after saving a mirrored SCL file. Skipped while `rung watch` runs, because watch imports and compiles the change itself (`sync.compile` in rung.toml)."
          }
        }
      },
      {
        "title": "Views and status bar",
        "order": 3,
        "properties": {
          "rung.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show the rung item in the status bar (watching, idle, conflicts, online PLCs). Click it for the list of rung actions."
          },
          "rung.projectView.grouping": {
            "type": "string",
            "enum": [
              "folder",
              "kind"
            ],
            "enumDescriptions": [
              "TIA Portal folders, as in the project tree.",
              "Blocks split into OB, FB, FC and DB; the folder is shown next to each block."
            ],
            "default": "folder",
            "description": "How the Project view groups program blocks."
          },
          "rung.projectView.showReadOnly": {
            "type": "boolean",
            "default": true,
            "description": "Show read-only objects (know-how protected, F- and GRAPH blocks) in the Project view."
          }
        }
      },
      {
        "title": "PLC",
        "order": 4,
        "properties": {
          "rung.online.refreshInterval": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "markdownDescription": "Check the online state of the PLCs every so many seconds while `rung watch` runs. `0` turns it off: the state is then checked after online, offline and download, and with the refresh button. Values below 5 count as 5."
          }
        }
      },
      {
        "title": "Download",
        "order": 5,
        "properties": {
          "rung.download.confirmation": {
            "type": "string",
            "enum": [
              "typeName",
              "modal"
            ],
            "enumDescriptions": [
              "After the warning dialog, type the PLC name to start the download.",
              "The warning dialog alone starts the download."
            ],
            "default": "typeName",
            "scope": "application",
            "markdownDescription": "How a download is confirmed. There is always a warning dialog naming the PLC and what is downloaded. User settings only, so a workspace cannot weaken it."
          },
          "rung.download.pickOptions": {
            "type": "boolean",
            "default": true,
            "description": "Before each download, show a list to choose software, hardware, all blocks and restart, preset from the settings below."
          },
          "rung.download.hardware": {
            "type": "string",
            "enum": [
              "rungToml",
              "include",
              "exclude"
            ],
            "enumDescriptions": [
              "Use [download].hardware from rung.toml (off unless set).",
              "Pass --hw: include the hardware configuration.",
              "Pass --no-hw: software only."
            ],
            "default": "rungToml",
            "description": "Whether a download includes the hardware configuration."
          },
          "rung.download.allBlocks": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Download all blocks instead of changed ones (`--all-blocks`)."
          },
          "rung.download.startAfter": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Start the CPU again if the download stopped it. Off passes `--no-start`. `[download].start_after = false` in rung.toml always wins."
          },
          "rung.download.allow": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "stop-cpu",
                "stop-h-system",
                "reinit-db",
                "init-memory",
                "reset-module",
                "overwrite-system-data",
                "different-target",
                "abort-active-test",
                "protection-level-changed",
                "overwrite-memory-card",
                "switch-to-primary",
                "selective-delete"
              ],
              "enumDescriptions": [
                "Stop the CPU.",
                "Stop the H system.",
                "Reinitialise data blocks (actual values are lost).",
                "Initialise memory.",
                "Reset the module (delete all).",
                "Overwrite system data.",
                "Download although the target configuration differs.",
                "Abort an active test or force job.",
                "Continue although the protection level changed.",
                "Overwrite the memory card.",
                "Switch the backup CPU to primary.",
                "Delete blocks that are not in the project."
              ]
            },
            "uniqueItems": true,
            "default": [],
            "scope": "application",
            "markdownDescription": "TIA Portal questions every download from this machine answers with **yes** (`--allow`), on top of `[download].allow` in rung.toml. **Leave this empty.** Each entry lets a download change the machine without asking again, for example stop the CPU. When TIA cancels a download, the extension offers a one-time retry that allows exactly what was asked. User settings only."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "rung.getStarted",
        "title": "Get started with rung",
        "description": "From a TIA Portal project to text files, tables and tests, in a few steps.",
        "steps": [
          {
            "id": "check",
            "title": "Check this computer",
            "description": "See what is installed and what is missing.\n[Check this computer](command:rung.env.refresh)",
            "media": {
              "markdown": "media/walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:rung.env.refresh"
            ]
          },
          {
            "id": "project",
            "title": "Mirror a TIA Portal project",
            "description": "Pull a project into a folder of text files. Writes stay off.\n[Mirror a project](command:rung.init)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:rung.workspace"
            ]
          },
          {
            "id": "declarations",
            "title": "See a block's interface",
            "description": "Open an SCL block and show its declarations as a table.\n[Show declarations](command:rung.declarations.open)",
            "media": {
              "markdown": "media/walkthrough/declarations.md"
            },
            "completionEvents": [
              "onCommand:rung.declarations.open"
            ]
          },
          {
            "id": "usages",
            "title": "Find who writes a value",
            "description": "Put the cursor on a name and list its writers and readers.\n[Who writes this?](command:rung.whoWrites)",
            "media": {
              "markdown": "media/walkthrough/usages.md"
            },
            "completionEvents": [
              "onCommand:rung.whoWrites"
            ]
          },
          {
            "id": "test",
            "title": "Run the tests",
            "description": "Run the YAML tests on the offline simulator.\n[Run all tests](command:rung.testAll)",
            "media": {
              "markdown": "media/walkthrough/test.md"
            },
            "completionEvents": [
              "onCommand:rung.testAll"
            ]
          },
          {
            "id": "preview",
            "title": "Preview a sync",
            "description": "See what would go to TIA Portal and what would come back. Nothing is written.\n[Preview sync](command:rung.preview)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:rung.preview"
            ]
          },
          {
            "id": "writes",
            "title": "Turn on writes when you are ready",
            "description": "Let saved files go to TIA Portal.\n[Turn on writes](command:rung.writes.on)",
            "media": {
              "markdown": "media/walkthrough/writes.md"
            },
            "completionEvents": [
              "onContext:rung.writesOn"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p . --noEmit && npm run build:ext && node scripts/build-webview.mjs",
    "package": "tsc -p . --noEmit && npm run build:ext -- --minify && node scripts/build-webview.mjs --minify && vsce package --no-dependencies -o rung-scl.vsix",
    "test:e2e": "tsc -p test-e2e && npm run build && node test-e2e/out/test-e2e/runTest.js",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --sourcemap --log-level=warning"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "smol-toml": "^1.9.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "mocha": "^12.0.2",
    "typescript": "~5.9.2"
  }
}
