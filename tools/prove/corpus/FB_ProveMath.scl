FUNCTION_BLOCK "FB_ProveMath"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      x : Real;
      i : Int;
      sel : Bool;
      k : Int;
      dw : DWord;
      txt : String[12];
   END_VAR

   VAR_OUTPUT
      root : Real;
      sine : Real;
      expo : Real;
      logn : Real;
      power : Real;
      norm : Real;
      scaled : Real;
      selected : Int;
      muxed : Int;
      inRange : Bool;
      swapped : DWord;
      rotated : DWord;
      asText : String[12];
      fromText : Int;
      realText : String[20];
      fcResult : Int;
      fcInOut : Int;
      counted : Int;
      frac : Real;
      modReal : Real;
   END_VAR

   VAR
      acc : Int;
      inner : "FB_ProveInner";
   END_VAR


BEGIN
	// REAL math
	IF #x >= 0.0 THEN
	    #root := SQRT(#x);
	END_IF;
	#sine := SIN(#x);
	#expo := EXP(#x / 10.0);
	IF #x > 0.0 THEN
	    #logn := LN(#x);
	END_IF;
	#power := #x ** 2;
	#frac := FRAC(#x);
	// scaling, selection
	#norm := NORM_X(MIN := 0, VALUE := #i, MAX := 27648);
	#scaled := SCALE_X(MIN := -10.0, VALUE := #norm, MAX := 10.0);
	#selected := SEL(G := #sel, IN0 := #i, IN1 := #k);
	#muxed := MUX(K := #k, IN0 := 10, IN1 := 11, IN2 := 12, INELSE := -1);
	#inRange := #k >= -5 AND #k <= 5;
	// bytes and bits
	#swapped := SWAP(#dw);
	#rotated := ROR(IN := #dw, N := 8);
	// strings and numbers
	#asText := INT_TO_STRING(#i);
	#fromText := STRING_TO_INT(#txt);
	#realText := REAL_TO_STRING(#x);
	// an FC with an in/out, and a multi-instance
	#acc := #k;
	#fcResult := "FC_ProveAdd"(a := #i, b := #k, total := #acc);
	#fcInOut := #acc;
	#inner(step := #k);
	#counted := #inner.count;
END_FUNCTION_BLOCK

