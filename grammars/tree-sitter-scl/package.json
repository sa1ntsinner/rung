{
  "name": "tree-sitter-scl",
  "version": "0.1.0",
  "description": "Siemens SCL (Structured Control Language) grammar for tree-sitter",
  "license": "MIT",
  "main": "bindings/node",
  "keywords": ["tree-sitter", "scl", "structured-text", "siemens", "plc", "iec-61131-3"],
  "files": ["grammar.js", "src", "queries", "LICENSE", "README.md"],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter generate && tree-sitter test"
  },
  "devDependencies": { "tree-sitter-cli": "^0.25.10" },
  "tree-sitter": [{ "scope": "source.scl", "file-types": ["scl", "db", "udt"], "highlights": "queries/highlights.scm" }]
}
